<Project>

  <!-- Settings shared by every project. Each tool's own Directory.Build.props imports this file and adds its
       Version, Product and ToolRoot. Project-specific settings stay in each .csproj. -->
  <PropertyGroup>
    <!-- See "Platform and build" in docs/GUIDELINES.md. Changing it here moves every project. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Where every tool's folder publish profile puts its executable. One folder, so adding it to PATH adds them
         all. Only those profiles read it; pass -p:PublishDir=<folder> to publish somewhere else. -->
    <ToolsPublishDir>$(USERPROFILE)\source\Executables\CodeDocumentationTools\</ToolsPublishDir>
  </PropertyGroup>

</Project>
