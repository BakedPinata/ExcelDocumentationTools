<Project>

  <!-- The SDK stamps the git commit into each assembly's informational version ("0.5.0+<sha>"), and vbadoc shows
       it in the pages it makes. A build from a working copy with uncommitted changes gets "-dirty" after the sha,
       so a page made by such a build can't be mistaken for one made from that commit. If git isn't available,
       the stamp is left as it is. -->
  <Target Name="AddDirtyMarkerToSourceRevision"
          AfterTargets="InitializeSourceControlInformation"
          Condition="'$(SourceRevisionId)' != ''">
    <Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_VbadocGitStatus" />
      <Output TaskParameter="ExitCode" PropertyName="_VbadocGitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_VbadocGitExitCode)' == '0' and '$(_VbadocGitStatus)' != ''">
      <SourceRevisionId>$(SourceRevisionId)-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
