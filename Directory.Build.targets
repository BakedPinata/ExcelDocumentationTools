<Project>

  <!-- The SDK stamps the git commit into each assembly's informational version ("0.5.0+<sha>"), and the tools show
       it in the pages they make. The tools share a repository, so each stamp is the last commit that touched that
       tool's folder ($(ToolRoot), set in its Directory.Build.props) or the root build files, not HEAD: otherwise a
       commit to one tool would change the stamp in every other tool's pages. Root docs don't count.

       Uncommitted changes in those same paths add "-dirty" after the sha, so a page made by such a build can't be
       mistaken for one made from that commit. If git isn't available, the stamp is left as it is. -->
  <Target Name="StampToolRevision"
          AfterTargets="InitializeSourceControlInformation"
          Condition="'$(SourceRevisionId)' != '' and '$(ToolRoot)' != ''">
    <PropertyGroup>
      <!-- Git runs in the tool's folder, so "." is the tool and ":/" paths start at the repository root. -->
      <_StampPaths>. :/Directory.Build.props :/Directory.Build.targets :/Directory.Packages.props :/global.json</_StampPaths>
    </PropertyGroup>
    <Exec Command="git rev-list -1 HEAD -- $(_StampPaths)" WorkingDirectory="$(ToolRoot)" ConsoleToMSBuild="true"
          StandardOutputImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ToolGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_ToolGitCommitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_ToolGitCommitExitCode)' == '0' and '$(_ToolGitCommit)' != ''">
      <SourceRevisionId>$(_ToolGitCommit)</SourceRevisionId>
    </PropertyGroup>
    <Exec Command="git -c core.safecrlf=false status --porcelain -- $(_StampPaths)" WorkingDirectory="$(ToolRoot)"
          ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ToolGitStatus" />
      <Output TaskParameter="ExitCode" PropertyName="_ToolGitStatusExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_ToolGitStatusExitCode)' == '0' and '$(_ToolGitStatus)' != ''">
      <SourceRevisionId>$(SourceRevisionId)-dirty</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
