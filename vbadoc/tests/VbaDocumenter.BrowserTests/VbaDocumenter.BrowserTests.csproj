<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VbaDocumenter.Core\VbaDocumenter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the workbook builder and fixtures with the unit tests rather than copying them. -->
    <Compile Include="..\VbaDocumenter.Tests\Support\*.cs" Link="Support\%(Filename)%(Extension)" />
    <None Include="..\VbaDocumenter.Tests\Fixtures\**\*" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
