<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Read directly as well as through the shared library: the VBA project is itself a compound file. -->
    <PackageReference Include="OpenMcdf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\CodeDocumenter.Shared\CodeDocumenter.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit LogicalName so resource names are the same on Windows and Linux. d3 comes from the shared library. -->
    <EmbeddedResource Include="Resources\Page\search.html" LogicalName="Page/search.html" />
    <EmbeddedResource Include="Resources\Page\views.html" LogicalName="Page/views.html" />
    <EmbeddedResource Include="Resources\Page\page.css" LogicalName="Page/page.css" />
    <EmbeddedResource Include="Resources\Page\page.js" LogicalName="Page/page.js" />
    <EmbeddedResource Include="Resources\Page\vba-highlight.js" LogicalName="Page/vba-highlight.js" />
    <EmbeddedResource Include="Resources\Page\graph.js" LogicalName="Page/graph.js" />
    <EmbeddedResource Include="Resources\Page\classes.js" LogicalName="Page/classes.js" />
    <EmbeddedResource Include="Resources\Page\calls.js" LogicalName="Page/calls.js" />
    <EmbeddedResource Include="Resources\Page\favicon.svg" LogicalName="Page/favicon.svg" />
  </ItemGroup>

</Project>
