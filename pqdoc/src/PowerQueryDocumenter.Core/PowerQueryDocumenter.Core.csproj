<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit LogicalName so resource names are the same on Windows and Linux. -->
    <!-- Vendored D3.js v7.9.0 (ISC licence). The licence is embedded too, because the page inlines it. -->
    <EmbeddedResource Include="Resources\Vendor\d3.min.js" LogicalName="Vendor/d3.min.js" />
    <EmbeddedResource Include="Resources\Vendor\d3.LICENSE.txt" LogicalName="Vendor/d3.LICENSE.txt" />
    <EmbeddedResource Include="Resources\Page\page.html" LogicalName="Page/page.html" />
    <EmbeddedResource Include="Resources\Page\page.css" LogicalName="Page/page.css" />
    <EmbeddedResource Include="Resources\Page\page.js" LogicalName="Page/page.js" />
    <EmbeddedResource Include="Resources\Page\graph.js" LogicalName="Page/graph.js" />
    <EmbeddedResource Include="Resources\Page\favicon.svg" LogicalName="Page/favicon.svg" />
  </ItemGroup>

</Project>
