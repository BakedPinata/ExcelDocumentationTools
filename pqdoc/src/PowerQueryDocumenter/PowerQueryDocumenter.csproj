<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PowerQueryDocumenter</RootNamespace>
    <AssemblyName>pqdoc</AssemblyName>
    <Version>1.0.0</Version>
    <!-- Keep the version output to the plain version number (no git commit hash suffix). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendored D3.js v7.9.0 (ISC licence, see Resources/Vendor/d3.LICENSE.txt), embedded into the HTML export. -->
    <EmbeddedResource Include="Resources\Vendor\d3.min.js" LogicalName="Vendor/d3.min.js" />
    <EmbeddedResource Include="Resources\graph-template.html" LogicalName="PowerQueryDocumenter.Resources.graph-template.html" />
    <None Include="Resources\Vendor\d3.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

</Project>
