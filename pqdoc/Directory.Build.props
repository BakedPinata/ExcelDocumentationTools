<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Version>1.9.1</Version>
    <Product>pqdoc</Product>
    <!-- The folder the build stamp follows: see Directory.Build.targets at the root. -->
    <ToolRoot>$(MSBuildThisFileDirectory)</ToolRoot>
  </PropertyGroup>

</Project>
