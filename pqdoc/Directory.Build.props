<Project>
  <!-- Settings shared by every project in the repository. -->
  <PropertyGroup>
    <!--
      The target framework is defined once, here. .NET 9, the same as vbadoc. Changing it here
      moves every project.
    -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>pqdoc</Product>
  </PropertyGroup>
</Project>
