<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit.net v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The app's assembly uses Windows Forms, so the tests load it with the Windows desktop runtime. No test opens a
         window. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeDocumenter.Desktop\CodeDocumenter.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One workbook from each tool's fixtures, to run the tools through the app's runner. -->
    <None Include="..\..\..\vbadoc\tests\VbaDocumenter.Tests\Fixtures\Workbooks\SimpleMacro.xlsm" Link="Fixtures\SimpleMacro.xlsm" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\pqdoc\tests\PowerQueryDocumenter.Tests\Fixtures\Workbooks\Queries.xlsx" Link="Fixtures\Queries.xlsx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
