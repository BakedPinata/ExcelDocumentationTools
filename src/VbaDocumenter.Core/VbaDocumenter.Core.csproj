<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MPL-2.0, used unmodified. Reads OLE compound files (vbaProject.bin, .xls).
         3.x rather than 2.x: 2.4.1 has two unpatched denial-of-service advisories (GHSA-jxpf-xq2m-q525, GHSA-5qwm-7pvp-w988). -->
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit LogicalName so resource names are the same on Windows and Linux. -->
    <EmbeddedResource Include="Resources\Vendor\d3.min.js" LogicalName="Vendor/d3.min.js" />
    <EmbeddedResource Include="Resources\Vendor\d3.LICENSE.txt" LogicalName="Vendor/d3.LICENSE.txt" />
    <EmbeddedResource Include="Resources\Vendor\mermaid.min.js" LogicalName="Vendor/mermaid.min.js" />
    <EmbeddedResource Include="Resources\Vendor\mermaid.LICENSE.txt" LogicalName="Vendor/mermaid.LICENSE.txt" />
    <EmbeddedResource Include="Resources\Page\page.html" LogicalName="Page/page.html" />
    <EmbeddedResource Include="Resources\Page\page.css" LogicalName="Page/page.css" />
    <EmbeddedResource Include="Resources\Page\page.js" LogicalName="Page/page.js" />
    <EmbeddedResource Include="Resources\Page\vba-highlight.js" LogicalName="Page/vba-highlight.js" />
    <EmbeddedResource Include="Resources\Page\graph.js" LogicalName="Page/graph.js" />
    <EmbeddedResource Include="Resources\Page\classes.js" LogicalName="Page/classes.js" />
  </ItemGroup>

</Project>
