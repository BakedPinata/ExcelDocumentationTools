# Build output
bin/
obj/
*.user
.vs/
.idea/
TestResults/

# Publish output. A relative publish folder lands inside each project, at <tool>/<src or tests>/<project>/. The rules
# for the tools' names are tied to that level, because the same names at the root are the tools themselves.
publish/
/*/*/*/pqdoc/
/*/*/*/vbadoc/

# Local test workbooks and their output (never committed)
private/

# Local configuration: may hold a private PlantUML server URL
.env

# Outputs produced by trying pqdoc inside the repository
powerquery-dependencies.*
